# Secret used to sign the anonymous player cookie. If unset, a random one is
# generated on first run and stored in data/secret (fine for local dev).
DOPAMINE_SECRET=

# Token required for the moderation API (POST /api/admin/submissions).
# Leave empty to disable the admin endpoint entirely.
ADMIN_TOKEN=

# Where game data and uploads are stored (JSON file store). Default: ./data
DATA_DIR=
